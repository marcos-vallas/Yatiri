code = "shader_type canvas_item;
render_mode blend_mix;

uniform float Freq_2 : hint_range(0.0, 30.0) = 5.0;
uniform float Freq_1 : hint_range(0.0, 30.0) = 5.0;




// 3D Noise with friendly permission by Inigo Quilez
vec3 hash_noise_range( vec3 p ) {
	p *= mat3(vec3(127.1, 311.7, -53.7), vec3(269.5, 183.3, 77.1), vec3(-301.7, 27.3, 215.3));
	return 2.0 * fract(fract(p)*4375.55) -1.;
}


void fragment() {
// Input:2
	vec2 n_out2p0 = UV;


// VectorDecompose:3
	float n_out3p0 = n_out2p0.x;
	float n_out3p1 = n_out2p0.y;


// Input:15
	float n_out15p0 = TIME;


// FloatParameter:16
	float n_out16p0 = Freq_2;


// FloatOp:17
	float n_out17p0 = n_out15p0 * n_out16p0;


// FloatFunc:18
	float n_out18p0 = sin(n_out17p0);


// RandomRange:12
	vec3 n_in12p0 = vec3(1.00000, 1.00000, 1.00000);
	float n_in12p1 = 0.00000;
	float n_out12p0 = mix(n_in12p1, n_out18p0, hash_noise_range(n_in12p0).x);


// FloatOp:4
	float n_out4p0 = n_out3p1 * n_out12p0;


// FloatFunc:5
	float n_out5p0 = sin(n_out4p0);


// Input:10
	float n_out10p0 = TIME;


// FloatParameter:13
	float n_out13p0 = Freq_1;


// FloatOp:14
	float n_out14p0 = n_out10p0 * n_out13p0;


// FloatFunc:9
	float n_out9p0 = sin(n_out14p0);


	float n_out11p0;
// Remap:11
	float n_in11p1 = -1.00000;
	float n_in11p2 = 1.00000;
	float n_in11p3 = 0.00000;
	float n_in11p4 = 1.00000;
	{
		float __input_range = n_in11p2 - n_in11p1;
		float __output_range = n_in11p4 - n_in11p3;
		n_out11p0 = n_in11p3 + __output_range * ((n_out9p0 - n_in11p1) / __input_range);
	}


	vec4 n_out7p0;
// Texture2D:7
	n_out7p0 = texture(TEXTURE, UV);
	float n_out7p4 = n_out7p0.a;


// Mix:8
	float n_out8p0 = mix(n_out5p0, n_out11p0, n_out7p4);


// FloatOp:19
	float n_in19p1 = 0.70000;
	float n_out19p0 = n_out8p0 * n_in19p1;


// Output:0
	COLOR.a = n_out19p0;


}
