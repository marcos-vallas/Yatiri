code = "shader_type canvas_item;
render_mode blend_mix;




void fragment() {
// Input:2
	vec2 n_out2p0 = UV;


// VectorDecompose:3
	float n_out3p0 = n_out2p0.x;
	float n_out3p1 = n_out2p0.y;


// FloatOp:4
	float n_in4p1 = 100.00000;
	float n_out4p0 = n_out3p1 * n_in4p1;


// FloatFunc:5
	float n_out5p0 = sin(n_out4p0);


	vec4 n_out7p0;
// Texture2D:7
	n_out7p0 = texture(TEXTURE, UV);
	float n_out7p4 = n_out7p0.a;


// Input:10
	float n_out10p0 = TIME;


// FloatFunc:9
	float n_out9p0 = sin(n_out10p0);


	float n_out11p0;
// Remap:11
	float n_in11p1 = -1.00000;
	float n_in11p2 = 1.00000;
	float n_in11p3 = 0.00000;
	float n_in11p4 = 1.00000;
	{
		float __input_range = n_in11p2 - n_in11p1;
		float __output_range = n_in11p4 - n_in11p3;
		n_out11p0 = n_in11p3 + __output_range * ((n_out9p0 - n_in11p1) / __input_range);
	}


// Mix:8
	float n_out8p0 = mix(n_out5p0, n_out7p4, n_out11p0);


// Output:0
	COLOR.a = n_out8p0;


}
